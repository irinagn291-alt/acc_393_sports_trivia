	<string>Record sound for a video you choose to attach.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose a photo or video to attach to a website form.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
